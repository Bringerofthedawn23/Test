{
  "name": "multiplatform-music-bot",
  "version": "1.0.0",
  "description": "A multi-platform, high-quality Discord music bot powered by discord.js v14 and Lavalink v4.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "deploy": "tsx src/deploy-commands.ts",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "music",
    "lavalink",
    "spotify",
    "youtube",
    "apple-music",
    "soundcloud"
  ],
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "lavalink-client": "^2.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
