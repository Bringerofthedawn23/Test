# ─────────────────────────────────────────────────────────────
#  Discord Music Bot — Environment Configuration
#  Copy this file to `.env` and fill in your own values.
# ─────────────────────────────────────────────────────────────

# ── Discord ──────────────────────────────────────────────────
# Your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# Your application (client) ID — found on the same page.
CLIENT_ID=your-application-id-here

# Optional: register slash commands instantly to a single guild
# while developing. Leave blank to register globally (can take
# up to an hour to propagate the first time).
GUILD_ID=

# ── Lavalink node ────────────────────────────────────────────
# When running via docker-compose, host is the service name
# `lavalink`. When running the bot locally against a local
# Lavalink, use `localhost`.
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

# ── Playback defaults ────────────────────────────────────────
# Default search platform when a user gives a plain text query.
# Options: ytsearch | ytmsearch | spsearch | amsearch | scsearch | dzsearch
DEFAULT_SEARCH=ytmsearch

# Default volume (0-100) when a player is first created.
DEFAULT_VOLUME=80

# ── Spotify / Apple Music / Deezer (LavaSrc plugin) ──────────
# These are read by Lavalink (see lavalink/application.yml).
# Spotify credentials from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Apple Music media API token (optional). Deezer requires no key
# for search/metadata but a valid ARL is needed for full tracks.
APPLE_MUSIC_TOKEN=
DEEZER_ARL=
