# Copy this file to `keystore.properties` (which is git-ignored) to enable
# signed release builds locally. Never commit the real file or the keystore.
#
# Generate a keystore first:
#   keytool -genkeypair -v -keystore release.keystore \
#     -alias my-key-alias -keyalg RSA -keysize 2048 -validity 10000
#
# `storeFile` is resolved relative to the project root.

storeFile=release.keystore
storePassword=CHANGE_ME
keyAlias=my-key-alias
keyPassword=CHANGE_ME
