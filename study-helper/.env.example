# Copy this file, rename the copy to ".env", and fill in your real values.
# NEVER share this file or commit the real .env to GitHub.

# --- Claude (required) ---
# Get a key at: https://console.anthropic.com  (Settings -> API Keys)
ANTHROPIC_API_KEY=sk-ant-paste-your-key-here

# --- Accounts + free trial (Supabase) ---
# From supabase.com -> your project -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_KEY=your-service-role-secret-key

# --- Payments (Stripe) ---
# From dashboard.stripe.com (start in TEST mode)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...          # the €4.99/month price you create
STRIPE_WEBHOOK_SECRET=whsec_...    # from the webhook you add in Stripe
